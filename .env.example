# Copy to ".env" and fill in values (never commit .env).
# Optional: put secrets only in local.env (gitignored) and run: python3 scripts/merge_local_env.py
#
# App database — set DB_TYPE to "postgres" or "sqlite" (default).
# For SQLite, only DB_PATH is used (defaults to data/project.db).
# For Postgres, fill in the five vars below.
DB_TYPE=sqlite
DB_PATH=data/project.db
# DB_TYPE=postgres
# DB_HOST=HOST
# DB_PORT=5432
# DB_NAME=DATABASE
# DB_USER=USER
# DB_PASSWORD=PASSWORD

# FastAPI CORS: default * (dev). For production use comma-separated origins:
# CORS_ALLOW_ORIGINS=http://localhost:8501,https://your-domain.com

# ── Default launch: API http://localhost:8000 , UI http://localhost:8501 ──
# If those ports are already taken on your machine, set host mapping + matching URLs:
# API_HOST_PORT=8001
# STREAMLIT_HOST_PORT=8502
# BACKEND_URL=http://localhost:8001
# When using Airflow in compose, allow the Streamlit origin (comma-separated if multiple):
# AIRFLOW_UI_ORIGINS=http://localhost:8501,http://localhost:8502

# Optional local Tesseract (host machine paths — Docker backend ignores and uses container paths)
# TESSERACT_PATH=/usr/local/bin/tesseract
# TESSDATA_PREFIX=/usr/local/share/tessdata

# ── Only if you use full docker-compose (Airflow services) ──
# AIRFLOW_UID=50000
# AIRFLOW_IMAGE_NAME=tariff-audit-airflow:3.1.7
# AIRFLOW__CORE__FERNET_KEY=generate-a-fernet-key
# AIRFLOW__API__SECRET_KEY=change-me
# AIRFLOW__API_AUTH__JWT_SECRET=change-me
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow
# AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@airflow-postgres:5432/airflow
# AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
# POSTGRES_USER=airflow
# POSTGRES_PASSWORD=airflow
# POSTGRES_DB=airflow

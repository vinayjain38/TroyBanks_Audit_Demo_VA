# Copy this file to .env and fill real values.
# .env is ignored by git.

# ============================================
# Local tooling
# ============================================
TESSERACT_PATH=C:\path\to\tesseract.exe
TESSDATA_PREFIX=C:\path\to\tessdata
OPENAI_API_KEY=

# ============================================
# App database configuration
# ============================================
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

# ============================================
# Airflow Docker Compose inputs
# ============================================
ENV_FILE_PATH=.env
AIRFLOW_PROJ_DIR=.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=tariff-audit-airflow:3.1.7

# ============================================
# Airflow secrets and credentials
# ============================================
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres/airflow
AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
